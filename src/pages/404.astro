---
// Fehlerseite. Styles: styles/404.scss
import Layout from '../layouts/layout.astro';
import '../styles/404.scss';
import { icon } from '../lib/icons';
---

<Layout title="Seite nicht gefunden">
  <header class="page-header">
    <div class="container page-header__content">
      <p class="eyebrow">Fehler 404</p>
      <h1 class="page-header__title">Hier beißt nichts an.</h1>
      <p class="page-header__intro">Diese Seite gibt es nicht (mehr). Vielleicht hilft die Startseite oder die Suche weiter.</p>
      <div class="page-header__actions">
        <a class="btn btn-dark" href="/">Zur Startseite <Fragment set:html={icon('arrow', 18)} /></a>
        <a class="btn btn-outline" href="/search/">Suche</a>
      </div>
    </div>
  </header>
</Layout>
