---
// Suche (/search/). Styles: styles/suche.scss · Script: scripts/suche.js
import Layout from '../layouts/layout.astro';
import '../styles/suche.scss';
import { icon } from '../lib/icons';
---

<Layout title="Suchergebnisse" description="Ergebnisse für die eingegebene Suche">
  <header class="page-header">
    <div class="container page-header__content">
      <p class="eyebrow">Beiträge durchsuchen</p>
      <h1 class="page-header__title">Suche</h1>
      <form class="search-form" action="/search/" role="search">
        <label class="visually-hidden" for="search-input">Suchbegriff</label>
        <Fragment set:html={icon('search', 22)} />
        <input id="search-input" name="s" type="search" placeholder="z. B. Zander, Besatz, Nagold …" autocomplete="off" />
        <button class="btn btn-dark" type="submit">Suchen</button>
      </form>
    </div>
  </header>

  <section class="container search-results">
    <p class="search-results__status" data-search-status aria-live="polite"></p>
    <div class="search-results__grid" data-search-results></div>
  </section>

  <script>
    import '../scripts/suche.js';
  </script>
</Layout>
