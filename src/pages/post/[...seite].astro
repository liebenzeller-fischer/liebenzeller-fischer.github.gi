---
// Beitragsliste „Aktuelles“: /post/ und /post/page/2/ …
// Styles: styles/beitraege.scss
import Layout from '../../layouts/layout.astro';
import '../../styles/beitraege.scss';
import { asset, dateLong, getPosts, pageNumbers, paginate, postUrl } from '../../lib/site';
import { icon } from '../../lib/icons';

export async function getStaticPaths() {
  return paginate(await getPosts(), '/post/').map(({ posts, info }) => ({
    params: { seite: info.current === 1 ? undefined : `page/${info.current}` },
    props: { posts, info },
  }));
}

const { posts, info } = Astro.props;
---

<Layout title="Aktuelles" description="Neuigkeiten vom Fischerverein Bad Liebenzell: Besatz, Hege und Gewässerpflege an Nagold und Stadtsee.">
  <header class="page-header">
    <div class="container page-header__content">
      <p class="eyebrow">Aktuelles</p>
      <h1 class="page-header__title">Neues vom Wasser</h1>
      <p class="page-header__intro">Besatz, Hege, Gewässeranalysen und Arbeitseinsätze – hier berichten wir, was an Nagold und Stadtsee passiert.</p>
    </div>
  </header>

  <section class="blog">
    <div class="container">
      <div class="blog__grid">
        {posts.map((post) => (
          <article class="post-card">
            <div class="post-card__media">
              <img src={asset(post.data.image)} alt="" loading="lazy" decoding="async" />
            </div>
            <div class="post-card__body">
              <div class="post-card__meta">
                <Fragment set:html={icon('calendar', 15)} />
                <time datetime={post.data.date.toISOString().slice(0, 10)}>{dateLong(post.data.date)}</time>
                {post.data.tags[0] && <span class="post-card__tag">{post.data.tags[0]}</span>}
              </div>
              <h3 class="post-card__title">
                <a href={postUrl(post)}>{post.data.title}</a>
              </h3>
              {post.data.description && <p class="post-card__excerpt">{post.data.description}</p>}
              <span class="post-card__more" aria-hidden="true">Weiterlesen <Fragment set:html={icon('arrow', 16)} /></span>
            </div>
          </article>
        ))}
      </div>

      {info.total > 1 && (
        <nav aria-label="Seiten">
          <ul class="pagination">
            {info.current > 1 && (
              <li class="page-item"><a href={info.url(info.current - 1)} class="page-link" aria-label="Vorherige Seite"><Fragment set:html={icon('arrow-left', 18)} /></a></li>
            )}
            {pageNumbers(info).map((n) => (
              <li class:list={['page-item', { active: n === info.current }]}>
                <a href={info.url(n)} class="page-link" aria-current={n === info.current ? 'page' : undefined}>{n}</a>
              </li>
            ))}
            {info.current < info.total && (
              <li class="page-item"><a href={info.url(info.current + 1)} class="page-link" aria-label="Nächste Seite"><Fragment set:html={icon('arrow', 18)} /></a></li>
            )}
          </ul>
        </nav>
      )}
    </div>
  </section>
</Layout>
