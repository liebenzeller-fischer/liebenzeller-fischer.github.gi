---
// Einzelner Beitrag: /post/<name>/ – Text aus content/posts/<name>.md
// Styles: styles/beitrag.scss
import { render } from 'astro:content';
import Layout from '../../layouts/layout.astro';
import '../../styles/beitrag.scss';
import { asset, dateLong, getPosts, postUrl, slugify } from '../../lib/site';
import { icon } from '../../lib/icons';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { beitrag: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { title, image, date, tags, description } = post.data;
const { Content } = await render(post);
---

<Layout title={title} description={description} image={image} type="article" published={date}>
  <article class="post">
    <header class="post__hero">
      <div class="post__hero-media">
        <img src={asset(image)} alt="" fetchpriority="high" />
      </div>
      <div class="container post__hero-content">
        <a class="post__back" href="/post/"><Fragment set:html={icon('arrow-left', 16)} /> Aktuelles</a>
        <h1 class="post__title">{title}</h1>
        <div class="post__meta">
          <span><Fragment set:html={icon('calendar', 16)} /> <time datetime={date.toISOString().slice(0, 10)}>{dateLong(date)}</time></span>
        </div>
      </div>
    </header>

    <div class="container post__layout">
      {description && <p class="post__lead">{description}</p>}
      <div class="content"><Content /></div>

      {tags.length > 0 && (
        <footer class="post__tags">
          <span>Themen</span>
          <ul class="chips">
            {tags.map((tag) => <li><a class="chip" href={`/tags/${slugify(tag)}/`}>{tag}</a></li>)}
          </ul>
        </footer>
      )}
    </div>

    {(prev || next) && (
      <nav class="container post__nav" aria-label="Weitere Beiträge">
        {prev ? (
          <a class="post__nav-link" href={postUrl(prev)}>
            <span><Fragment set:html={icon('arrow-left', 16)} /> Neuer</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : <span />}
        {next && (
          <a class="post__nav-link post__nav-link--next" href={postUrl(next)}>
            <span>Älter <Fragment set:html={icon('arrow', 16)} /></span>
            <strong>{next.data.title}</strong>
          </a>
        )}
      </nav>
    )}
  </article>
</Layout>
