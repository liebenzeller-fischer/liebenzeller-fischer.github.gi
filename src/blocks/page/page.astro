---
import './page.scss';
import { render, type CollectionEntry } from 'astro:content';
import PageHeader from '../page-header/page-header.astro';
import Content from '../content/content.astro';
import { asset } from '../../lib/site';

interface Props {
  page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;
const { title, eyebrow, intro, hero } = page.data;
const { Content: Body } = await render(page);
---

<PageHeader title={title} eyebrow={eyebrow} intro={intro} image={hero && asset(hero)} />
<div class="container page">
  <Content><Body /></Content>
</div>
