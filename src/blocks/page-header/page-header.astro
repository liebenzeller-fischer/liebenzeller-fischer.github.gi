---
import './page-header.scss';

interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  image?: string;
}

const { title, eyebrow, intro, image } = Astro.props;
---

<header class:list={['page-header', { 'page-header--image': image }]}>
  {image && (
    <div class="page-header__media">
      <img src={image} alt="" fetchpriority="high" />
    </div>
  )}
  <div class="container page-header__content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="page-header__title"><slot>{title}</slot></h1>
    {intro && <p class="page-header__intro">{intro}</p>}
    <slot name="after" />
  </div>
</header>
