---
import './pagination.scss';
import Icon from '../icon/icon.astro';
import type { PageInfo } from '../../lib/site';

interface Props {
  info: PageInfo;
}

const { info } = Astro.props;

// gleiche Logik wie die Hugo-Vorlage: max. 2 Seiten links/rechts der aktuellen
const adjacent = 2;
const maxLinks = adjacent * 2 + 1;
const numbers = Array.from({ length: info.total }, (_, i) => i + 1).filter((n) => {
  if (info.total <= maxLinks) return true;
  if (info.current <= adjacent + 1) return n <= maxLinks;
  if (info.current >= info.total - adjacent) return n > info.total - maxLinks;
  return Math.abs(n - info.current) <= adjacent;
});
---

{info.total > 1 && (
  <nav aria-label="Seiten">
  <ul class="pagination">
    {info.current > 1 && (
      <li class="page-item"><a href={info.url(info.current - 1)} class="page-link" aria-label="Vorherige Seite"><Icon name="arrow-left" size={18} /></a></li>
    )}
    {numbers.map((n) => (
      <li class:list={['page-item', { active: n === info.current }]}>
        <a href={info.url(n)} class="page-link" aria-current={n === info.current ? 'page' : undefined}>{n}</a>
      </li>
    ))}
    {info.current < info.total && (
      <li class="page-item"><a href={info.url(info.current + 1)} class="page-link" aria-label="Nächste Seite"><Icon name="arrow" size={18} /></a></li>
    )}
  </ul>
  </nav>
)}
