---
import './blog.scss';
import PostCard from '../post-card/post-card.astro';
import Pagination from '../pagination/pagination.astro';
import type { PageInfo, Post } from '../../lib/site';

interface Props {
  posts: Post[];
  info: PageInfo;
}

const { posts, info } = Astro.props;
---

<section class="blog">
  <div class="container">
    <div class="blog__grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <Pagination info={info} />
  </div>
</section>
