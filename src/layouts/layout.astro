---
// Grundgerüst jeder Seite: <head>, Kopf (Header), Fuß (Footer),
// Hintergrund-Fische und Nach-oben-Button. Styles: styles/layout.scss, Script: scripts/layout.js
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/inter';
import '../styles/layout.scss';
import { SITE, MENU, asset } from '../lib/site';
import { icon } from '../lib/icons';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
}

const { title, description = SITE.description, image, type = 'website', published } = Astro.props;
const fullTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(asset(image), Astro.site) : undefined;

const path = Astro.url.pathname;
const isActive = (url: string) => path === url || (url !== '/' && path.startsWith(url));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#173129" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/images/favicon.jpeg" type="image/jpeg" />
    <link rel="alternate" type="application/rss+xml" href="/index.xml" title={SITE.title} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="de_DE" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
  </head>

  <body>
    <!-- Hintergrund-Fische: das Script klont die Vorlagen unten -->
    <div class="fish-swim" aria-hidden="true" data-fish-swim></div>

    <template id="fish-swim-template">
      <!-- Forelle: gedrungen, getupft, runde Schwanzflosse -->
      <div class="fish-swim__fish fish-swim__fish--forelle" data-species="forelle">
        <div class="fish-swim__bob">
          <svg class="fish-swim__svg" viewBox="0 0 120 50">
            <g class="fish-swim__tail">
              <path d="M24 25 4 9c3 5 4.5 10.5 4.5 16S7 36 4 41z" />
            </g>
            <path class="fish-swim__fin" d="M50 11c5-7 15-9 22-6l-4 7z" />
            <path class="fish-swim__fin" d="M58 36c3 5 9 7 13 6l-3-6z" />
            <path class="fish-swim__body" d="M22 25C34 9 72 5 100 17c7 3 12 5.5 12 8s-5 5-12 8C72 45 34 41 22 25z" />
            <g class="fish-swim__marks">
              <circle cx="42" cy="18" r="1.6" />
              <circle cx="52" cy="15" r="1.4" />
              <circle cx="60" cy="19" r="1.7" />
              <circle cx="69" cy="15" r="1.3" />
              <circle cx="78" cy="18.5" r="1.4" />
              <circle cx="48" cy="28" r="1.2" />
              <circle cx="64" cy="27" r="1.3" />
            </g>
            <circle class="fish-swim__eye" cx="101" cy="22" r="2.2" />
          </svg>
        </div>
      </div>

      <!-- Äsche: schlank, große Rückenflosse ("Fahne"), gegabelte Schwanzflosse -->
      <div class="fish-swim__fish fish-swim__fish--aesche" data-species="aesche">
        <div class="fish-swim__bob">
          <svg class="fish-swim__svg" viewBox="0 0 120 50">
            <g class="fish-swim__tail">
              <path d="M26 26 5 12l7 14-7 14z" />
            </g>
            <path class="fish-swim__fin fish-swim__flag" d="M38 20C36 2 68-8 90 12l-6 5C70 12 52 13 40 21z" />
            <path class="fish-swim__fin" d="M60 33c2 5 7 7 11 7l-2-6z" />
            <path class="fish-swim__body" d="M24 26c12-9 44-12 72-8 9 1 15 4 16 7-1 3-7 5-16 7-28 4-60 2-72-6z" />
            <g class="fish-swim__marks">
              <circle cx="80" cy="21" r="1" />
              <circle cx="86" cy="23" r="1" />
              <circle cx="76" cy="25" r=".9" />
            </g>
            <circle class="fish-swim__eye" cx="103" cy="24" r="2" />
          </svg>
        </div>
      </div>

      <!-- Barbe: lang gestreckt, gewölbter Rücken, spitze Schnauze mit Barteln -->
      <div class="fish-swim__fish fish-swim__fish--barbe" data-species="barbe">
        <div class="fish-swim__bob">
          <svg class="fish-swim__svg" viewBox="0 0 120 50">
            <g class="fish-swim__tail">
              <path d="M24 27 4 13l8 14-8 14z" />
            </g>
            <path class="fish-swim__fin" d="M56 15l9-11 6 12z" />
            <path class="fish-swim__fin" d="M62 35l6 7 5-6z" />
            <path class="fish-swim__body" d="M22 27c12-13 50-17 78-8 8 3 13 6 15 9-3 2-9 3-16 3-28 5-62 6-77-4z" />
            <path class="fish-swim__barbels" d="M111 30l2 6M107 31l1 6M103 31l-1 5" />
            <circle class="fish-swim__eye" cx="103" cy="24" r="1.8" />
          </svg>
        </div>
      </div>
    </template>

    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <!-- ========== Kopf ========== -->
    <header class="site-header" data-header>
      <div class="container site-header__inner">
        <a class="site-header__brand" href="/" aria-label={`${SITE.title} – Startseite`}>
          <img src="/images/design/logo-dark.png" alt="" width="140" height="47" />
        </a>

        <nav class="site-nav" id="site-nav" aria-label="Hauptmenü">
          <ul class="site-nav__list">
            {MENU.map((item) => (
              <li>
                <a class:list={['site-nav__link', { 'is-active': isActive(item.url) }]} href={item.url} aria-current={isActive(item.url) ? 'page' : undefined}>
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
          <a class="btn btn-dark site-nav__cta" href="/kontakt/#mitgliedschaft">Mitglied werden</a>
        </nav>

        <div class="site-header__tools">
          <a class="site-header__icon" href="/search/" aria-label="Suche"><Fragment set:html={icon('search')} /></a>
          <button class="site-header__icon site-header__burger" type="button" aria-controls="site-nav" aria-expanded="false" data-nav-toggle>
            <span class="visually-hidden">Menü</span>
            <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <!-- ========== Fuß ========== -->
    <footer class="site-footer">
      <svg class="site-footer__wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 40c120-26 240-26 360 0s240 26 360 0 240-26 360 0 240 26 360 0v40H0z" />
      </svg>

      <div class="container site-footer__grid">
        <div class="site-footer__about">
          <img class="site-footer__logo" src="/images/design/logo-light.png" alt={SITE.title} width="168" height="56" loading="lazy" />
          <p>Fliegenfischen, Hege und Gewässerschutz an Nagold und Stadtsee – seit {SITE.founded} in Bad Liebenzell.</p>
        </div>

        <div>
          <h2 class="site-footer__title">Verein</h2>
          <ul class="site-footer__links">
            {MENU.map((item) => <li><a href={item.url}>{item.name}</a></li>)}
          </ul>
        </div>

        <div>
          <h2 class="site-footer__title">Kontakt</h2>
          <ul class="site-footer__links site-footer__contact">
            <li><Fragment set:html={icon('pin', 18)} /><span>Bergstraße 30/1<br />75399 Unterreichenbach</span></li>
            <li><Fragment set:html={icon('mail', 18)} /><span>{SITE.email}</span></li>
          </ul>
        </div>
      </div>

      <div class="container site-footer__bottom">
        <span>© {year} {SITE.title}</span>
        <nav aria-label="Rechtliches">
          <a href="/impressum/">Impressum</a>
          <a href="/datenschutz/">Datenschutz</a>
        </nav>
      </div>
    </footer>

    <!-- Nach-oben-Button: springt per Anker zum Seitenanfang, auch ohne JavaScript -->
    <a class="back-to-top" href="#top" aria-label="Nach oben" data-back-to-top>
      <Fragment set:html={icon('arrow-up', 20)} />
    </a>

    <script>
      import '../scripts/layout.js';
    </script>
  </body>
</html>
